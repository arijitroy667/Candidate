# Vercel frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Render backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Use the JWT-format legacy service_role key (typically starts with eyJ), not sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase Postgres connection string (server-side only)
DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project.supabase.co:5432/postgres

SUPABASE_STORAGE_BUCKET=resumes
APP_ENV=local
API_CORS_ORIGINS=http://localhost:3000

# Optional Gemini resume-review provider. Without a key, ranking uses the labeled
# deterministic evidence-based fallback until an LLM key is configured.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
